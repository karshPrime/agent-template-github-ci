{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "shared Renovate settings for karshosphere templates and the projects generated from them",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests",
    ":semanticCommitScopeDisabled"
  ],
  "timezone": "Australia/Melbourne",
  "schedule": ["before 6am on sunday"],
  "updateNotScheduled": false,
  "vulnerabilityAlerts": {
    "schedule": ["before 6am on sunday"]
  },
  "separateMajorMinor": false,
  "separateMultipleMajor": false,
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "dependencyDashboard": true,
  "automerge": false,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "packageRules": [
    {
      "description": "one weekly pull request for every update, merged as a single release",
      "matchPackageNames": ["*"],
      "groupName": "all dependencies",
      "groupSlug": "all"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "versions marked with a renovate comment on the line above",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/", "/(^|/)Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+(?:ARG |ENV )?[\\w-]+[:=] *\"?(?<currentValue>[^\\s\"@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\"?"
      ]
    }
  ]
}
